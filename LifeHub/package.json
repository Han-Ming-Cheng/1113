{
  "name": "lifehub-line-five-in-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config wrangler.toml --keep-vars",
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v && node --experimental-strip-types --test tests/worker-smoke.test.mjs",
    "db:local": "wrangler d1 migrations apply lifehub-db --local",
    "db:remote": "wrangler d1 migrations apply lifehub-db --remote",
    "menu": "node scripts/generate-menu.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.16.0"
  }
}
